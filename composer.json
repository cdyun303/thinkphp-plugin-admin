{
  "name": "cdyun/thinkphp-plugin-admin",
  "description": "Thinkphp Admin 模块插件",
  "license": "MIT",
  "keywords": [
    "php",
    "admin",
    "thinkphp",
    "cdyun"
  ],
  "authors": [
    {
      "name": "cdyun",
      "email": "121625706@qq.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "app\\admin\\": "src"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "cdyun/thinkphp-installer": true
    }
  },
  "extra": {
    "config": {
      "type": "module",
      "name": "系统后台管理",
      "document": "https://github.com/cdyun303/thinkphp-plugin-admin.git",
      "description": "后台基础管理模块，系统账号及安全配置管理。"
    },
    "plugin": {
      "copy": {
        "src": "!app/admin"
      },
      "clear": true
    }
  }
}