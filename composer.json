{
  "name": "cdyun/thinkphp-plugin-admin",
  "description": "Thinkphp Admin 模块插件",
  "license": "MIT",
  "keywords": [
    "php",
    "admin",
    "thinkphp",
    "cdyun"
  ],
  "authors": [
    {
      "name": "cdyun",
      "email": "121625706@qq.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.1",
    "topthink/think-view": "^2.0",
    "topthink/think-captcha": "^3.0",
    "cdyun/thinkphp-plugin-static": "^1.0",
    "cdyun/php-tool": "^2.0",
    "cdyun/thinkphp-upload": "^1.0",
    "cdyun/thinkphp-response": "^2.0",
    "cdyun/thinkphp-cache": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Thinkphp\\Admin\\": "src"
    }
  },
  "extra": {
    "config": {
      "type": "module",
      "name": "系统后台管理",
      "document": "https://github.com/cdyun303/thinkphp-plugin-admin.git",
      "description": "后台基础管理模块，系统账号及安全配置管理。"
    },
    "plugin": {
      "src": "app/admin"
    }
  }
}